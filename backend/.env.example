# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# SQLite database file (relative to the backend/ folder). Created by the first migration.
DATABASE_URL=file:./prisma/dev.db
# Tests use their own throwaway file, recreated on every test run.
TEST_DATABASE_URL=file:./prisma/test.db

# Allowed browser origin (the frontend URL). Credentials (cookies) are enabled for it.
CORS_ORIGIN=http://localhost:5173

# Signs the 15-minute access tokens. Use a long random string (32+ characters).
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-32-plus-chars
# Refresh tokens are random opaque strings (stored hashed), valid this many days.
REFRESH_TOKEN_TTL_DAYS=7

# The first admin, created by `npm run seed`.
# Choose your own password (10-72 characters). It lives only in .env, never in git.
SEED_ADMIN_EMAIL=admin@inventoryos.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Admin

# Password for the demo users created by the seed (managers, employees, viewer).
# Leave empty to reuse SEED_ADMIN_PASSWORD.
SEED_DEMO_PASSWORD=
